# Copy to .env.local. Use your own Supabase project or `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-or-local-anon-key
# Optional server-only composition. Without these, the deterministic safety
# fallback creates the draft and the tablet workflow still works.
OPENAI_API_KEY=replace-with-server-only-key
OPENAI_MODEL=replace-with-json-capable-model
# Optional server-only Realtime voice model for the primary tablet check-in.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
